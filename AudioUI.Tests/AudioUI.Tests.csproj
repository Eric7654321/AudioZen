<Project Sdk="Microsoft.NET.Sdk">

  <!-- TFM 跟著 Infra 走：要測的實作在那一層。 -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- 拿真實的樣板檔來測，才驗得到「樣板」與「讀它的程式」有沒有漂移。 -->
  <ItemGroup>
    <None Include="..\AudioUI\appsettings.example.json" Link="appsettings.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AudioUI.Core\AudioUI.Core.csproj" />
    <ProjectReference Include="..\AudioUI.Infra\AudioUI.Infra.csproj" />
  </ItemGroup>

</Project>
