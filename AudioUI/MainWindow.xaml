<Window x:Class="AudioUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="AI Audio Mixer" Height="700" Width="1129"
        Icon="icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="#000000"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
        </Style>

        <!-- ★★★ 修正後的 NavBtnStyle ★★★ -->
        <!-- 解決 C# 設定顏色後 Hover 失效的問題 -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <!-- 1. 給 ContentPresenter 一個名字 (x:Name="Presenter") -->
                            <!-- 2. 明確綁定 TextElement.Foreground，預設使用 Button 的顏色 -->
                            <ContentPresenter x:Name="Presenter" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 3. 改成針對內部的 "Presenter" 設定顏色 -->
                            <!-- 這樣就算 C# 把外層 Button 鎖死成灰色，這裡依然能強制變藍 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="#3399FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 視窗控制按鈕樣式 (維持白色 Hover) -->
        <Style x:Key="WindowControlBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                                <!-- 這裡強制設回白色 -->
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 側邊欄樣式 -->
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片樣式 (高度 140) -->
        <DataTemplate x:Key="AppCardTemplate">
            <Border Width="340" Height="140" 
                    BorderBrush="{Binding BorderColor}" 
                    BorderThickness="1" Margin="10,10,10,20" Background="#1E1E1E">
                <Grid Margin="15,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <Border Grid.Column="0" Background="#333333" Margin="0,0,15,0" CornerRadius="5">
                        <Grid>
                            <Image Source="{Binding Icon}" Stretch="Uniform" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <icon:PackIconMaterial Kind="Monitor" Width="50" Height="50" Foreground="#3399FF" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <icon:PackIconMaterial.Style>
                                    <Style TargetType="icon:PackIconMaterial">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </icon:PackIconMaterial.Style>
                            </icon:PackIconMaterial>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                        <Separator Background="#555555" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding VolumeText}" FontSize="15" Foreground="#BBBBBB" Margin="0,2"/>
                        <TextBlock Text="{Binding ToneText}" FontSize="15" Foreground="#BBBBBB" Margin="0,2"/>
                        <TextBlock Text="{Binding OtherText}" FontSize="15" Foreground="#BBBBBB" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 裝置卡片樣式 （加入點擊事件處理） -->
        <DataTemplate x:Key="DeviceCardTemplate">
            <!-- 在 Border 上加 MouseLeftButtonUp，minimal change -->
            <Border Width="260" Height="320" 
                    BorderBrush="#444444" 
                    BorderThickness="1" Margin="15" Background="#1E1E1E" Cursor="Hand"
                    MouseLeftButtonUp="DeviceCard_Click">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#888888"/>
                                <Setter Property="Background" Value="#252525"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="24" Foreground="White" FontWeight="Normal"/>
                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="14" Foreground="#888888" Margin="0,5,0,0"/>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <Image Source="{Binding ImagePath}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <icon:PackIconMaterial Kind="KeyboardVariant" Width="80" Height="80" Foreground="#444444" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <icon:PackIconMaterial.Style>
                                <Style TargetType="icon:PackIconMaterial">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </icon:PackIconMaterial.Style>
                        </icon:PackIconMaterial>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Logo -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
            <Image Source="icon.png" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Window Controls -->
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowControlBtnStyle}" Padding="5">
                <icon:PackIconMaterial Kind="Cog" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource WindowControlBtnStyle}" Padding="5" Margin="5,0,20,0">
                <icon:PackIconMaterial Kind="Account" Width="16" Height="16"/>
            </Button>
            <Button Content="—" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding MinimizeCommand}"/>
            <Button Content="☐" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding MaximizeCommand}"/>
            <Button Content="✕" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding CloseCommand}" Foreground="#FF6666"/>
        </StackPanel>

        <!-- 導航列 -->
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="40,0,0,10">
            <Grid>
                <Button x:Name="TabEntrance" Content="入 口" Click="Tab_Click" Tag="Entrance"
                        Style="{StaticResource NavBtnStyle}" Foreground="#3399FF" FontWeight="Bold"/>
                <Border x:Name="LineEntrance" VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2"/>
            </Grid>
            <Grid>
                <Button x:Name="TabControl" Content="控 制" Click="Tab_Click" Tag="Control"
                        Style="{StaticResource NavBtnStyle}"/>
                <Border x:Name="LineControl" VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2" Visibility="Hidden"/>
            </Grid>
            <Grid>
                <Button x:Name="TabDevice" Content="裝 置" Click="Tab_Click" Tag="Device"
                        Style="{StaticResource NavBtnStyle}"/>
                <Border x:Name="LineDevice" VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2" Visibility="Hidden"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderBrush="#333333" BorderThickness="0,0,0,1"/>

        <!-- 側邊欄 -->
        <Border x:Name="SidebarBorder" Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="15,20,15,20">
                <StackPanel>
                    <Button Content="+ 新聊天" Style="{StaticResource SidebarItemStyle}" Foreground="White" FontWeight="Bold"/>
                    <Button Content="心頻氣和是什麼" Style="{StaticResource SidebarItemStyle}"/>
                    <Separator Background="#333333" Margin="10,20"/>
                    <TextBlock Text="聊天紀錄" Foreground="#666666" FontSize="22" Margin="10,0,0,10"/>
                    <StackPanel>
                        <Button Content="耳機有耳鳴聲" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="音效知識科普" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="討厭金屬聲" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="被苦力怕炸飛" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="Dc某人常爆麥" Style="{StaticResource SidebarItemStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- VIEW A: 入口 -->
        <Grid x:Name="EntranceView" Grid.Row="2" Grid.Column="1" ClipToBounds="True" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-50,0,0">
                <TextBlock Text="早安您好 平安喜樂~" FontSize="32" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <Border Background="#1E1E1E" CornerRadius="28" Width="600" Height="56">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="+" Foreground="#888888" FontSize="28" Background="Transparent" BorderThickness="0" Margin="20,-6,10,5" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="我想知道Reverb是什麼?" Foreground="#555555" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ChatInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="ChatInputBox" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" FontSize="18" CaretBrush="White" VerticalContentAlignment="Center" Padding="0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                        <Button Grid.Column="2" Margin="10" Width="40" Height="40" Cursor="Hand" Command="{Binding MicrophoneCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#333333" CornerRadius="20">
                                        <icon:PackIconMaterial Kind="Microphone" Foreground="#AAAAAA" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom">
                <Grid HorizontalAlignment="Center">
                    <Polygon Points="0,25 10,0 70,0 80,25" Fill="#252525" HorizontalAlignment="Center"/>
                    <Button x:Name="DrawerBtn" Click="DrawerBtn_Click" Style="{StaticResource NavBtnStyle}" Margin="0" Width="80" Height="25">
                        <icon:PackIconMaterial x:Name="DrawerIcon" Kind="ChevronUp" Width="20" Height="20" Foreground="#888888"/>
                    </Button>
                </Grid>
                <Border x:Name="StatusDrawer" Height="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10">
                        <ItemsControl ItemsSource="{Binding AppList}" ItemTemplate="{StaticResource AppCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>

        <!-- VIEW B: 控制 -->
        <Grid x:Name="ControlView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Hidden" Margin="20,10,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="18" Height="40">
                    <Grid>
                        <TextBlock Text="搜尋:" Foreground="#666666" VerticalAlignment="Center" Margin="15,0" FontSize="16" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" Margin="15,0" CaretBrush="White"/>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Content="調整錄音檔" Width="150" Height="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#252525" CornerRadius="20" BorderBrush="#333333" BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="#DDDDDD" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="最近調整" FontSize="18" Foreground="#DDDDDD" Margin="5,10,0,10"/>
                    <ItemsControl ItemsSource="{Binding RecentAppList}" ItemTemplate="{StaticResource AppCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Separator Background="#333333" Margin="0,20"/>
                    <Grid Margin="5,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SortModeText" Text="排序模式: 名稱 (A-Z)" FontSize="18" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SortBtn_Click">
                            <icon:PackIconMaterial Kind="Sort" Foreground="White" Width="24" Height="24"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="名稱 (A -> Z)" Click="SortOption_Click" Tag="NameAsc"/>
                                    <MenuItem Header="名稱 (Z -> A)" Click="SortOption_Click" Tag="NameDesc"/>
                                    <Separator/>
                                    <MenuItem Header="音量 (大 -> 小)" Click="SortOption_Click" Tag="VolumeDesc"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AppList}" ItemTemplate="{StaticResource AppCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Height="50"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- VIEW C: 裝置 -->
        <Grid x:Name="DeviceView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Hidden" Margin="20,10,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Border Background="#1E1E1E" CornerRadius="18" Height="40" HorizontalAlignment="Left" Width="350">
                    <Grid>
                        <TextBlock Text="搜尋裝置..." Foreground="#666666" VerticalAlignment="Center" Margin="15,0" FontSize="16"/>
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" Margin="15,0" CaretBrush="White"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- 裝置卡片列表（點擊卡片會觸發 DeviceCard_Click） -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding DeviceList}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- 新增容器後保留原本 DeviceDetailPanel（內容完全不變） -->
                    <Grid x:Name="DeviceDetailPanel" Visibility="Collapsed" Margin="10,20,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左側：裝置資訊 + 快捷鍵清單 -->
                        <StackPanel Grid.Column="0" Margin="8">
                            <TextBlock Text="裝置" FontSize="20" Foreground="White" Margin="4"/>
                            <TextBlock Text="{Binding SelectedDevice.Name}" FontSize="16" Foreground="#DDDDDD" Margin="4,2,0,8"/>
                            <TextBlock Text="自定義宏鍵盤" FontSize="20" Foreground="White" Margin="4,8,0,6"/>
                            <ListBox ItemsSource="{Binding ShortcutList}" Background="Transparent" BorderThickness="0" Foreground="White" Margin="4" >
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="6">
                                            <TextBlock Text="{Binding Title}" FontSize="18" Foreground="White"/>
                                            <TextBlock Text="{Binding SubTitle}" FontSize="13" Foreground="#888888" Margin="0,4,0,8"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- 右側：鍵盤顯示區（3 x 4）-->
                        <Border Grid.Column="1" Margin="12" Background="#111111" CornerRadius="12" Padding="12" BorderBrush="#444444" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="鍵盤" FontSize="18" Foreground="White"/>

                                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                    <UniformGrid Columns="3" Rows="4" HorizontalAlignment="Center" VerticalAlignment="Top">
                                        <ItemsControl ItemsSource="{Binding KeyBindings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Margin="8" Padding="8" Click="KeyButton_Click" Tag="{Binding}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding KeyLabel}" FontSize="16" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding EffectName}" FontSize="12" HorizontalAlignment="Center" Foreground="#AAAAAA" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </UniformGrid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>