<Window x:Class="AudioUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:AudioUI"
        mc:Ignorable="d"
        Title="AI Audio Mixer" Height="700" Width="1129"
        Icon="icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="#000000"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 卡片的圖示與框線從 AudioAppInfo 的純資料算出來；那個型別住在 Core，
             不認得 ImageSource 與 Brush。 -->
        <local:AppIconConverter x:Key="AppIcon"/>
        <local:ConfigBorderConverter x:Key="ConfigBorder"/>
        <Style x:Key="PresetBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="118"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pb" Background="#252525" CornerRadius="22" BorderBrush="#3A3A3A" BorderThickness="1">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="#DDDDDD" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="18,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pb" Property="Background" Value="#333333"/>
                                <Setter TargetName="pb" Property="BorderBrush" Value="#3399FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
        </Style>
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter x:Name="Presenter" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Presenter" Property="TextElement.Foreground" Value="#3399FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowControlBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="AppCardTemplate">
            <!-- 這個 template 三個地方共用（入口的抽屜、控制分頁的最近調整與完整清單），
                 所以「點了會進調參」不掛在這裡，掛在控制分頁那兩個 ItemsControl 上。 -->
            <Border Width="340" Height="140" BorderBrush="{Binding HasConfig, Converter={StaticResource ConfigBorder}}" BorderThickness="1" Margin="10,10,10,20" Background="#1E1E1E">
                <Grid Margin="15,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#333333" Margin="0,0,15,0" CornerRadius="5">
                        <Grid>
                            <Image Source="{Binding IconPath, Converter={StaticResource AppIcon}}" Stretch="Uniform" Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconPath, Converter={StaticResource AppIcon}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <icon:PackIconMaterial Kind="Monitor" Width="50" Height="50" Foreground="#3399FF" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <icon:PackIconMaterial.Style>
                                    <Style TargetType="icon:PackIconMaterial">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconPath, Converter={StaticResource AppIcon}}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </icon:PackIconMaterial.Style>
                            </icon:PackIconMaterial>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                        <Separator Background="#555555" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding VolumeText}" FontSize="15" Foreground="#BBBBBB" Margin="0,2"/>
                        <TextBlock Text="{Binding ToneText}" FontSize="15" Foreground="#BBBBBB" Margin="0,2"/>
                        <TextBlock Text="{Binding OtherText}" FontSize="15" Foreground="#BBBBBB" Margin="0,2"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="DeviceCardTemplate">
            <Button Click="DeviceCard_Click" Cursor="Hand" Margin="15" Padding="0" Background="Transparent" BorderThickness="0" Width="260" Height="320" Style="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder" Background="#1E1E1E" BorderBrush="#444444" BorderThickness="1">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding Name}" FontSize="24" Foreground="White" FontWeight="Normal"/>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="14" Foreground="#888888" Margin="0,5,0,0"/>
                                <Grid Grid.Row="2" Margin="0,20,0,0">
                                    <Image Source="{Binding ImagePath, TargetNullValue={x:Null}}" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <icon:PackIconMaterial Kind="KeyboardVariant" Width="80" Height="80" Foreground="#444444" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <icon:PackIconMaterial.Style>
                                            <Style TargetType="icon:PackIconMaterial">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </icon:PackIconMaterial.Style>
                                    </icon:PackIconMaterial>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#888888"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="#252525"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
            <Image Source="icon.png" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button x:Name="SettingsGearButton" Style="{StaticResource WindowControlBtnStyle}" Padding="5" Click="SettingsGear_Click" ToolTip="設定">
                <icon:PackIconMaterial Kind="Cog" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource WindowControlBtnStyle}" Padding="5" Margin="5,0,20,0">
                <icon:PackIconMaterial Kind="Account" Width="16" Height="16"/>
            </Button>
            <Button Content="—" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding MinimizeCommand}"/>
            <Button Content="☐" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding MaximizeCommand}"/>
            <Button Content="✕" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding CloseCommand}" Foreground="#FF6666"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="40,0,0,10">
            <Grid>
                <Button x:Name="TabEntrance" Content="入 口" Click="Tab_Click" Tag="Entrance" Style="{StaticResource NavBtnStyle}" Foreground="#3399FF" FontWeight="Bold"/>
                <Border x:Name="LineEntrance" VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2"/>
            </Grid>
            <Grid>
                <Button x:Name="TabControl" Content="控 制" Click="Tab_Click" Tag="Control" Style="{StaticResource NavBtnStyle}"/>
                <Border x:Name="LineControl" VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2" Visibility="Hidden"/>
            </Grid>
            <Grid>
                <Button x:Name="TabDevice" Content="裝 置" Click="Tab_Click" Tag="Device" Style="{StaticResource NavBtnStyle}"/>
                <Border x:Name="LineDevice" VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2" Visibility="Hidden"/>
            </Grid>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" BorderBrush="#333333" BorderThickness="0,0,0,1"/>
        <Border x:Name="SidebarBorder" Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="15,20,15,20">
                <StackPanel>
                    <Button Content="+ 新聊天" Click="NewChat_Click" Style="{StaticResource SidebarItemStyle}" Foreground="White" FontWeight="Bold"/>
                    <Separator Background="#333333" Margin="10,20"/>
                    <TextBlock Text="聊天紀錄" Foreground="#666666" FontSize="22" Margin="10,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding ChatList}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}" Tag="{Binding Id}" Click="ChatSession_Click" Style="{StaticResource SidebarItemStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid x:Name="EntranceView" Grid.Row="2" Grid.Column="1" ClipToBounds="True" Visibility="Visible">
            <Grid x:Name="DefaultEntrancePanel" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-50,0,0">
                    <TextBlock Text="早安您好 平安喜樂~" FontSize="32" Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,0,0,40"/>
                    <Border Background="#1E1E1E" CornerRadius="28" Width="600" Height="56">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+" Foreground="#888888" FontSize="28" Background="Transparent" BorderThickness="0" Margin="20,-6,10,5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="我想知道Reverb是什麼?" Foreground="#555555" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ChatInputBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="ChatInputBox" KeyDown="ChatInputBox_KeyDown" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" FontSize="18" CaretBrush="White" VerticalContentAlignment="Center" Padding="0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                            <Button Grid.Column="2" Margin="10" Width="40" Height="40" Cursor="Hand" Command="{Binding MicrophoneCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#333333" CornerRadius="20">
                                            <icon:PackIconMaterial Kind="Microphone" Foreground="#AAAAAA" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom">
                    <Grid HorizontalAlignment="Center">
                        <Polygon Points="0,25 10,0 70,0 80,25" Fill="#252525" HorizontalAlignment="Center"/>
                        <Button x:Name="DrawerBtn" Click="DrawerBtn_Click" Style="{StaticResource NavBtnStyle}" Margin="0" Width="80" Height="25">
                            <icon:PackIconMaterial x:Name="DrawerIcon" Kind="ChevronUp" Width="20" Height="20" Foreground="#888888"/>
                        </Button>
                    </Grid>
                    <Border x:Name="StatusDrawer" Height="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10">
                            <ItemsControl ItemsSource="{Binding AppList}" ItemTemplate="{StaticResource AppCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2. 聊天對話介面 (ItemsControl) -->
            <Grid x:Name="ChatSessionPanel" Visibility="Collapsed" Background="#000000">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" Margin="20,0,20,10" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="MsgContainer" Margin="0,10" HorizontalAlignment="Left">
                                    <Border x:Name="MsgBubble" Background="Transparent" CornerRadius="12" Padding="15,12" MaxWidth="600">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Message}" Foreground="#DDDDDD" FontSize="16" TextWrapping="Wrap" LineHeight="24"/>
                                            <Border x:Name="AudioPlayer" Margin="0,12,0,0" Background="#222222" CornerRadius="8" Padding="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <!-- 新增：套用按鈕區 -->
                                                    </Grid.ColumnDefinitions>
                                                    <Button Click="PlayAudio_Click" Tag="{Binding AudioFolderPath}" Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <icon:PackIconMaterial Kind="PlayCircle" Width="30" Height="30" Foreground="#3399FF"/>
                                                    </Button>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <TextBlock Text="錄音樣本" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                        <TextBlock Text="點擊試聽" Foreground="#888888" FontSize="12"/>
                                                    </StackPanel>

                                                    <!-- ★★★ 套用按鈕 (點擊才更新 Config) ★★★ -->
                                                    <Button Grid.Column="2" Click="ApplyPreview_Click" Tag="{Binding ConfigPath}" 
                                                            Visibility="{Binding ApplyVisibility}"
                                                            Width="80" Height="30" Background="#3399FF" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="15">
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <icon:PackIconMaterial Kind="Check" Width="12" Height="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                                        <TextBlock Text="套用" Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="MsgContainer" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="MsgBubble" Property="Background" Value="#333333"/>
                                        <Setter TargetName="AudioPlayer" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasAudio}" Value="False">
                                        <Setter TargetName="AudioPlayer" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="0,0,0,20" HorizontalAlignment="Center">
                    <Border Background="#1E1E1E" CornerRadius="28" Width="600" Height="56">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+" Foreground="#888888" FontSize="28" Background="Transparent" BorderThickness="0" Margin="20,-6,10,5" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Grid Grid.Column="1" VerticalAlignment="Center">
                                <TextBox x:Name="AdjustmentInputBox" KeyDown="AdjustmentInputBox_KeyDown" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" FontSize="18" CaretBrush="White" VerticalContentAlignment="Center" Padding="0">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                                <TextBlock Text="輸入調整指令 (例如: 再大聲一點)..." Foreground="#555555" FontSize="18" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=AdjustmentInputBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <Button Grid.Column="2" Click="SendAdjustment_Click" Margin="10" Width="40" Height="40" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="#DDDDDD" CornerRadius="20">
                                            <icon:PackIconMaterial Kind="ArrowUp" Foreground="#1E1E1E" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="ControlView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Hidden" Margin="20,10,20,0">
          <Grid x:Name="ControlListContainer">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1E1E1E" CornerRadius="18" Height="40">
                    <Grid>
                        <TextBlock Text="搜尋:" Foreground="#666666" VerticalAlignment="Center" Margin="15,0" FontSize="16" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" Margin="15,0" CaretBrush="White"/>
                    </Grid>
                </Border>
                <Button Grid.Column="2" Content="調整錄音檔" Width="150" Height="40">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#252525" CornerRadius="20" BorderBrush="#333333" BorderThickness="1">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="#DDDDDD" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="最近調整" FontSize="18" Foreground="#DDDDDD" Margin="5,10,0,10"/>
                    <ItemsControl ItemsSource="{Binding RecentAppList}" ItemTemplate="{StaticResource AppCardTemplate}"
                                  Cursor="Hand" MouseLeftButtonDown="AppCard_Click">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Separator Background="#333333" Margin="0,20"/>
                    <Grid Margin="5,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SortModeText" Text="排序模式: 名稱 (A-Z)" FontSize="18" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SortBtn_Click">
                            <icon:PackIconMaterial Kind="Sort" Foreground="White" Width="24" Height="24"/>
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="名稱 (A -> Z)" Click="SortOption_Click" Tag="NameAsc"/>
                                    <MenuItem Header="名稱 (Z -> A)" Click="SortOption_Click" Tag="NameDesc"/>
                                    <Separator/>
                                    <MenuItem Header="音量 (大 -> 小)" Click="SortOption_Click" Tag="VolumeDesc"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding AppList}" ItemTemplate="{StaticResource AppCardTemplate}"
                                  Cursor="Hand" MouseLeftButtonDown="AppCard_Click">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border Height="50"/>
                </StackPanel>
            </ScrollViewer>
          </Grid>

          <!-- 手動調參。跟 DeviceView 用同一種切換方式：清單與細節在同一格裡互換。 -->
          <Grid x:Name="TuningPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BackToAppList_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0">
                        <icon:PackIconMaterial Kind="ChevronLeft" Width="26" Height="26" Foreground="#DDDDDD"/>
                    </Button>
                    <TextBlock Text="{Binding Tuning.TargetName}" FontSize="26" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Tuning.ModeName}" FontSize="16" Foreground="#777777" VerticalAlignment="Center" Margin="14,4,0,0"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="152" Margin="0"
                        Content="{Binding Tuning.ModeToggleText}" Click="ToggleTuningMode_Click" Style="{StaticResource PresetBtnStyle}"/>
            </Grid>

            <!-- 一般模式 -->
            <StackPanel Grid.Row="1" Visibility="{Binding Tuning.IsSimpleMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="音量縮放" FontSize="18" Foreground="#DDDDDD" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <Slider Grid.Column="0" Minimum="0" Maximum="100" VerticalAlignment="Center"
                            Value="{Binding Tuning.VolumePercent, Mode=TwoWay}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Tuning.VolumeText}" FontSize="18" Foreground="White"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="音色調整" FontSize="18" Foreground="#DDDDDD" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Tuning.ToneOptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Name}" Tag="{Binding Id}" Click="TonePreset_Click" Style="{StaticResource PresetBtnStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 專業模式 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding Tuning.IsProMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="EQ" FontSize="20" Foreground="#DDDDDD" Margin="0,0,0,10"/>
                    <Border Background="#151515" CornerRadius="12" Padding="20,18" Margin="0,0,0,24">
                        <ItemsControl ItemsSource="{Binding Tuning.Bands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding GainText}" FontSize="14" Foreground="#3399FF"
                                                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <Slider Orientation="Vertical" Height="170" HorizontalAlignment="Center"
                                                Minimum="{Binding Min}" Maximum="{Binding Max}"
                                                Value="{Binding Gain, Mode=TwoWay}"/>
                                        <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#999999"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="Compressor" FontSize="20" Foreground="#DDDDDD" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Tuning.CompressorOptions}" Margin="0,0,0,20">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding Id}" Click="CompressorPreset_Click" Style="{StaticResource PresetBtnStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Reverb" FontSize="20" Foreground="#DDDDDD" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Tuning.ReverbOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding Id}" Click="ReverbPreset_Click" Style="{StaticResource PresetBtnStyle}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="30"/>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="音色：" FontSize="15" Foreground="#777777"/>
                    <TextBlock Text="{Binding Tuning.ToneText}" FontSize="15" Foreground="#DDDDDD" Margin="0,0,18,0"/>
                    <TextBlock Text="壓縮：" FontSize="15" Foreground="#777777"/>
                    <TextBlock Text="{Binding Tuning.CompressorName}" FontSize="15" Foreground="#DDDDDD" Margin="0,0,18,0"/>
                    <TextBlock Text="殘響：" FontSize="15" Foreground="#777777"/>
                    <TextBlock Text="{Binding Tuning.ReverbName}" FontSize="15" Foreground="#DDDDDD"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="重設" Width="110" Click="ResetTuning_Click" Style="{StaticResource PresetBtnStyle}"/>
                    <Button Content="套用" Width="130" Click="ApplyTuning_Click" Style="{StaticResource PresetBtnStyle}"/>
                </StackPanel>
            </Grid>
          </Grid>
        </Grid>


        <!-- 設定。做成第四個分頁而不是 hi-fi 的齒輪浮層：分頁切換這套機制在這個 codebase 已經在跑。 -->
        <Grid x:Name="SettingsView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Hidden" Margin="20,10,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,10,20,0">
                <Button x:Name="SettingsNavGeneral" Content="一般" Tag="General" Click="SettingsNav_Click" Style="{StaticResource PresetBtnStyle}" HorizontalAlignment="Stretch"/>
                <Button x:Name="SettingsNavMemory" Content="記憶" Tag="Memory" Click="SettingsNav_Click" Style="{StaticResource PresetBtnStyle}" HorizontalAlignment="Stretch"/>
                <Button x:Name="SettingsNavPersonal" Content="個人化" Tag="Personal" Click="SettingsNav_Click" Style="{StaticResource PresetBtnStyle}" HorizontalAlignment="Stretch"/>
                <Button x:Name="SettingsNavProfile" Content="設定檔" Tag="Profile" Click="SettingsNav_Click" Style="{StaticResource PresetBtnStyle}" HorizontalAlignment="Stretch"/>
                <Button x:Name="SettingsNavAbout" Content="關於" Tag="About" Click="SettingsNav_Click" Style="{StaticResource PresetBtnStyle}" HorizontalAlignment="Stretch"/>
            </StackPanel>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,10,0,0">
                <Grid>
                    <!-- 一般 -->
                    <StackPanel x:Name="SettingsPageGeneral" Visibility="Visible">
                        <TextBlock Text="執行環境" FontSize="24" Foreground="White" Margin="0,0,0,12"/>
                        <Border Background="#1A1A1A" CornerRadius="8" Padding="14,12" Margin="0,0,0,28">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Vm.DependencySummary}" FontSize="16" Foreground="#DDDDDD" VerticalAlignment="Center"/>
                                    <Button Content="重新檢查" Width="110" Height="34" MinWidth="0" Margin="0"
                                            HorizontalAlignment="Right" Click="RefreshDependencies_Click" Style="{StaticResource PresetBtnStyle}"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Vm.Dependencies.Problems}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="14" Foreground="#E0A030" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Separator Background="#2A2A2A" Margin="0,14,0,10"/>
                                <TextBlock Text="把正在播放的程式各自指到該走的虛擬裝置，取代手動去 Voicemeeter 與系統音量設定裡逐個點。"
                                           FontSize="14" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="自動接線" Width="120" Height="34" MinWidth="0" Margin="0,0,12,0"
                                            Click="WireRouting_Click" Style="{StaticResource PresetBtnStyle}"/>
                                    <TextBlock Text="{Binding Vm.RoutingStatus}" FontSize="14" Foreground="#3399FF"
                                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="420"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="一般設定" FontSize="24" Foreground="White" Margin="0,0,0,24"/>
                        <CheckBox Content="在開機時自動啟用應用程式" Foreground="#DDDDDD" FontSize="17"
                                  IsChecked="{Binding Preferences.LaunchAtStartup, Mode=TwoWay}"/>
                        <TextBlock Text="有你的角落，我們一直都在" FontSize="14" Foreground="#777777" Margin="26,4,0,22"/>
                        <CheckBox Content="自動更新" Foreground="#DDDDDD" FontSize="17"
                                  IsChecked="{Binding Preferences.AutoUpdate, Mode=TwoWay}"/>
                        <TextBlock Text="確保提供您的服務品質日日如新" FontSize="14" Foreground="#777777" Margin="26,4,0,0"/>
                    </StackPanel>

                    <!-- 記憶 -->
                    <StackPanel x:Name="SettingsPageMemory" Visibility="Collapsed">
                        <TextBlock Text="使用者記憶" FontSize="24" Foreground="White" Margin="0,0,0,24"/>
                        <CheckBox Content="啟用使用者記憶" Foreground="#DDDDDD" FontSize="17"
                                  IsChecked="{Binding Preferences.UserMemoryEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="尊敬的使用者您好，請介紹一下你自己吧" FontSize="14" Foreground="#777777" Margin="26,4,0,8"/>
                        <Border Background="#1A1A1A" CornerRadius="8" Margin="26,0,0,26" Padding="12,10">
                            <TextBox Text="{Binding Preferences.UserMemory, Mode=TwoWay}" Background="Transparent"
                                     BorderThickness="0" Foreground="#E0E0E0" FontSize="15" CaretBrush="White"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"/>
                        </Border>

                        <TextBlock Text="AI 記憶" FontSize="24" Foreground="White" Margin="0,0,0,24"/>
                        <CheckBox Content="啟用 AI 記憶" Foreground="#DDDDDD" FontSize="17"
                                  IsChecked="{Binding Preferences.AiMemoryEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="您一次一次一次的調整，仍舊記憶如新" FontSize="14" Foreground="#777777" Margin="26,4,0,10"/>
                        <ItemsControl ItemsSource="{Binding Preferences.AiMemories}" Margin="26,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#1A1A1A" CornerRadius="8" Margin="0,0,0,8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding}" Foreground="#DDDDDD" FontSize="15" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Click="RemoveMemory_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0">
                                                <icon:PackIconMaterial Kind="Close" Width="16" Height="16" Foreground="#888888"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Content="啟用 AI 自學功能 (experimental)" Foreground="#DDDDDD" FontSize="17" Margin="0,16,0,0"
                                  IsChecked="{Binding Preferences.SelfLearningEnabled, Mode=TwoWay}"/>
                        <TextBlock Text="讓 AI 根據你的歷史習慣以及記憶內容自動調整音訊輸出" FontSize="14" Foreground="#777777" Margin="26,4,0,0"/>
                    </StackPanel>

                    <!-- 個人化 -->
                    <StackPanel x:Name="SettingsPagePersonal" Visibility="Collapsed">
                        <TextBlock Text="喚醒詞設定" FontSize="24" Foreground="White" Margin="0,0,0,24"/>
                        <TextBlock Text="想要叫我什麼呢？" FontSize="15" Foreground="#DDDDDD" Margin="0,0,0,8"/>
                        <Border Background="#1A1A1A" CornerRadius="8" Width="320" HorizontalAlignment="Left" Padding="12,10" Margin="0,0,0,10">
                            <TextBox Text="{Binding Preferences.WakeWord, Mode=TwoWay}" Background="Transparent"
                                     BorderThickness="0" Foreground="#E0E0E0" FontSize="16" CaretBrush="White"/>
                        </Border>
                        <TextBlock Text="改完要重開程式，語音辨識的文法在啟動時就掛上去了。" FontSize="14" Foreground="#777777" Margin="0,0,0,20"/>
                        <TextBlock Text="目前的喚醒詞" FontSize="15" Foreground="#777777"/>
                        <TextBlock Text="{Binding Preferences.EffectiveWakeWord}" FontSize="20" Foreground="#3399FF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 設定檔 -->
                    <StackPanel x:Name="SettingsPageProfile" Visibility="Collapsed">
                        <TextBlock Text="Gemini API Key" FontSize="24" Foreground="White" Margin="0,0,0,10"/>
                        <TextBlock Text="在 Google AI Studio 申請，貼進來就好。存起來時會用 Windows 帳號加密，不會以明文留在磁碟上。"
                                   FontSize="14" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <Border Background="#1A1A1A" CornerRadius="8" Width="420" HorizontalAlignment="Left" Padding="12,10" Margin="0,0,0,12">
                            <PasswordBox x:Name="ApiKeyBox" Background="Transparent" BorderThickness="0"
                                         Foreground="#E0E0E0" FontSize="16" CaretBrush="White"/>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="儲存" Width="110" Click="SaveApiKey_Click" Style="{StaticResource PresetBtnStyle}"/>
                            <Button Content="測試連線" Width="130" Click="TestApiKey_Click" Style="{StaticResource PresetBtnStyle}"/>
                            <Button Content="清除" Width="110" Click="ClearApiKey_Click" Style="{StaticResource PresetBtnStyle}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="目前：" FontSize="15" Foreground="#777777"/>
                            <TextBlock Text="{Binding Vm.ApiKeyMasked}" FontSize="15" Foreground="#DDDDDD" Margin="0,0,18,0"/>
                            <TextBlock Text="{Binding Vm.ApiKeyStatus}" FontSize="15" Foreground="#3399FF"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 關於 -->
                    <StackPanel x:Name="SettingsPageAbout" Visibility="Collapsed">
                        <TextBlock Text="關於" FontSize="24" Foreground="White" Margin="0,0,0,20"/>
                        <TextBlock Text="心頻氣和 AudioZen" FontSize="20" Foreground="#DDDDDD"/>
                        <TextBlock Text="用自然語言控制桌面音訊。EQ 與音量走 Equalizer APO，壓縮與殘響走 MeldaProduction VST。"
                                   FontSize="15" Foreground="#777777" TextWrapping="Wrap" Margin="0,10,0,0" MaxWidth="520" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="DeviceView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Hidden" Margin="20,10,20,0">
            <!-- 略過 DeviceView 內容，已完成 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Border Background="#1E1E1E" CornerRadius="18" Height="40" HorizontalAlignment="Left" Width="350">
                    <Grid>
                        <TextBlock Text="搜尋裝置..." Foreground="#666666" VerticalAlignment="Center" Margin="15,0" FontSize="16"/>
                        <TextBox Background="Transparent" BorderThickness="0" Foreground="White" FontSize="16" VerticalContentAlignment="Center" Margin="15,0" CaretBrush="White"/>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Row="1">
                <ScrollViewer x:Name="DeviceListContainer" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                    <ItemsControl ItemsSource="{Binding DeviceList}" ItemTemplate="{StaticResource DeviceCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <Grid x:Name="DeviceDetailPanel" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#000000" BorderBrush="#333333" BorderThickness="0,0,1,0" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="10,0,0,10">
                                <Button Content="← 返回列表" Click="BackToDeviceList_Click" HorizontalAlignment="Left" Foreground="#3399FF" Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="16"/>
                                <TextBlock Text="{Binding SelectedDeviceName}" FontSize="28" Foreground="White" FontWeight="Bold" Margin="0,10,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Button Content="更換圖片" Width="110" Height="34" MinWidth="0" Click="PickDeviceImage_Click" Style="{StaticResource PresetBtnStyle}"/>
                                    <Button Content="還原預設" Width="110" Height="34" MinWidth="0" Click="ResetDeviceImage_Click" Style="{StaticResource PresetBtnStyle}"/>
                                </StackPanel>
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding ConfigOptions}" SelectionChanged="ConfigList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="20,15"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="#333333" BorderThickness="0,0,0,1">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#1A1A1A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="#252525"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock FontSize="20" Foreground="White" Margin="0,0,0,5"><Run Text="{Binding DisplayName}"/><Run Text=" - " Foreground="#888888"/><Run Text="{Binding SituationId}" Foreground="#3399FF"/></TextBlock>
                                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#888888" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Content="重置所有按鍵設定" Click="ResetAllKeys_Click" Margin="20" Height="40" Background="#331111" Foreground="#FF6666" BorderThickness="1" BorderBrush="#883333" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#551111"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" Background="#050505">
                        <Image Source="{Binding SelectedDeviceImagePath, TargetNullValue={x:Null}}" Stretch="Uniform" Opacity="1.0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Viewbox Stretch="Uniform">
                            <Grid Width="600" Height="600">
                                <Border Margin="110,70,110,90" BorderBrush="White" BorderThickness="2" CornerRadius="30" IsHitTestVisible="False"/>
                                <ItemsControl ItemsSource="{Binding MacroKeys}" Margin="120,80,120,100">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="3" Rows="4"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Click="KeyButton_Click" Tag="{Binding}" Width="110" Height="90" Margin="4" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="BtnBorder" CornerRadius="15" BorderBrush="White" BorderThickness="2" Background="#33000000">
                                                            <Viewbox>
                                                                <TextBlock Text="{Binding BoundActionName}" Foreground="White" FontWeight="Bold" Margin="5"/>
                                                            </Viewbox>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#663399FF"/>
                                                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#3399FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Viewbox>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>