<Window x:Class="AudioUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        Title="AI Audio Mixer" Height="700" Width="1129"
        WindowStyle="None" AllowsTransparency="True" Background="#000000"
        ResizeMode="CanResizeWithGrip">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="5" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
        </Style>

        <!-- 1. 頂部導航按鈕樣式 (字體 28) -->
        <Style x:Key="NavBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="Margin" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 2. 視窗控制按鈕樣式 -->
        <Style x:Key="WindowControlBtnStyle" TargetType="Button" BasedOn="{StaticResource NavBtnStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <!-- 3. 側邊欄項目樣式 -->
        <Style x:Key="SidebarItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Microsoft JhengHei UI"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- === 主要排版 Grid === -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- === 1. 左上角 Logo (修正為直接顯示原圖) === -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0">
            <!-- 
               改用 Image 標籤直接顯示，不裁切。
               Stretch="Uniform" 會保持原圖比例縮放塞進去。
               如果你希望圖片大一點，可以把 Height/Width 調大，或者拿掉 Margin。
            -->
            <Image Source="icon.png" 
                   Width="80" 
                   Height="80" 
                   Stretch="Uniform" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>
        </Grid>

        <!-- === 右上角視窗控制鈕 === -->
        <StackPanel Grid.Row="0" Grid.Column="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Top"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowControlBtnStyle}" Padding="5">
                <icon:PackIconMaterial Kind="Cog" Width="16" Height="16"/>
            </Button>
            <Button Style="{StaticResource WindowControlBtnStyle}" Padding="5" Margin="5,0,20,0">
                <icon:PackIconMaterial Kind="Account" Width="16" Height="16"/>
            </Button>
            <Button Content="—" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding MinimizeCommand}"/>
            <Button Content="☐" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding MaximizeCommand}"/>
            <Button Content="✕" Style="{StaticResource WindowControlBtnStyle}" Command="{Binding CloseCommand}" Foreground="#FF6666"/>
        </StackPanel>

        <!-- === 中間導航分頁 === -->
        <StackPanel Grid.Row="1" Grid.Column="1" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Bottom" 
                    Margin="40,0,0,10">
            <Grid>
                <Button Content="入 口" Style="{StaticResource NavBtnStyle}" Foreground="#3399FF" FontWeight="Bold"/>
                <Border VerticalAlignment="Bottom" Height="4" Background="#3399FF" Margin="20,0,20,-4" CornerRadius="2"/>
            </Grid>
            <Button Content="控 制" Style="{StaticResource NavBtnStyle}"/>
            <Button Content="裝 置" Style="{StaticResource NavBtnStyle}"/>
        </StackPanel>

        <!-- === 分隔線 === -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                VerticalAlignment="Bottom" 
                BorderBrush="#333333" 
                BorderThickness="0,0,0,1"/>

        <!-- === 左側邊欄內容 === -->
        <Border Grid.Row="2" Grid.Column="0" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Hidden" Margin="15,20,15,20">
                <StackPanel>
                    <Button Content="+ 新聊天" Style="{StaticResource SidebarItemStyle}" Foreground="White" FontWeight="Bold"/>

                    <!-- 修正：心頻氣和 -->
                    <Button Content="心頻氣和是什麼" Style="{StaticResource SidebarItemStyle}"/>

                    <Separator Background="#333333" Margin="10,20"/>
                    <TextBlock Text="聊天紀錄" Foreground="#666666" FontSize="22" Margin="10,0,0,10"/>
                    <StackPanel>
                        <Button Content="耳機有耳鳴聲" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="音效知識科普" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="討厭金屬聲" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="被苦力怕炸飛" Style="{StaticResource SidebarItemStyle}"/>
                        <Button Content="Dc某人常爆麥" Style="{StaticResource SidebarItemStyle}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- === 右側主內容區 === -->
        <Grid Grid.Row="2" Grid.Column="1" ClipToBounds="True">
            <!-- 
               ClipToBounds="True" 很重要！
               這樣當抽屜縮下去的時候，才不會跑到視窗外面或是蓋到底下的東西 
            -->

            <!-- 背景內容 (問候語 + 輸入框) -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-50,0,0">
                <TextBlock Text="早安您好 平安喜樂~" 
                           FontSize="32" 
                           Foreground="#AAAAAA" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"/>

                <Border Background="#1E1E1E" CornerRadius="28" Width="600" Height="56">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左側+號按鈕 -->
                        <Button Grid.Column="0" Content="+" Foreground="#888888" FontSize="28" 
                                Background="Transparent" BorderThickness="0" Margin="20,-6,10,5" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- 中間輸入區 -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="我想知道Reverb是什麼?" Foreground="#555555" FontSize="20" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ChatInputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox x:Name="ChatInputBox" Background="Transparent" BorderThickness="0" Foreground="#E0E0E0" FontSize="18" CaretBrush="White" VerticalContentAlignment="Center" Padding="0">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <!-- 麥克風 -->
                        <Button Grid.Column="2" Margin="10" Width="40" Height="40" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#333333" CornerRadius="20">
                                        <icon:PackIconMaterial Kind="Microphone" Foreground="#AAAAAA" Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 
                === 底部抽屜區 (Bottom Drawer) === 
                這是一個 StackPanel，包含「開關按鈕」和「狀態面板」。
                VerticalAlignment="Bottom" 讓它固定在底部。
            -->
            <StackPanel VerticalAlignment="Bottom">

                <!-- 1. 抽屜開關按鈕 (箭頭) -->
                <Grid HorizontalAlignment="Center">
                    <!-- 為了美觀，加一個梯形或是半圓形的背景在箭頭後面 (選用) -->
                    <Polygon Points="0,25 10,0 70,0 80,25" Fill="#252525" HorizontalAlignment="Center"/>

                    <Button x:Name="DrawerBtn" 
                            Click="DrawerBtn_Click"
                            Style="{StaticResource NavBtnStyle}" 
                            Margin="0,0,0,0"
                            Width="80" Height="25">
                        <!-- 給 Icon 一個名字，這樣我們可以在程式碼裡把箭頭轉向 -->
                        <icon:PackIconMaterial x:Name="DrawerIcon" Kind="ChevronUp" Width="20" Height="20" Foreground="#888888"/>
                    </Button>
                </Grid>

                <!-- 2. 抽屜內容 (狀態面板) -->
                <!-- 預設高度為 0 (隱藏)，背景色設深一點區隔 -->
                <Border x:Name="StatusDrawer" Height="0" Background="#252525" BorderBrush="#333333" BorderThickness="0,1,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                            <!-- 卡片 1: Minecraft -->
                            <Border Width="280" Height="100" BorderBrush="#555555" BorderThickness="1" Margin="10" Background="#1E1E1E">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icon (這裡用正方形模擬) -->
                                    <Border Grid.Column="0" Background="#333333" Margin="0,0,10,0">
                                        <!-- 用綠色方塊假裝是草方塊 -->
                                        <icon:PackIconMaterial Kind="Minecraft" Width="50" Height="50" 
                                                               Foreground="#55DD55" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- 文字資訊 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Minecraft" FontSize="18" Foreground="White" Margin="0,0,0,5"/>
                                        <!-- 底線 -->
                                        <Separator Background="#666666" Margin="0,0,0,5"/>
                                        <TextBlock Text="音量縮放: 100%" FontSize="14" Foreground="#BBBBBB"/>
                                        <TextBlock Text="音色調整: 無" FontSize="14" Foreground="#BBBBBB"/>
                                        <TextBlock Text="其他: 無" FontSize="14" Foreground="#BBBBBB"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 卡片 2: Google Meet -->
                            <Border Width="280" Height="100" BorderBrush="#555555" BorderThickness="1" Margin="10" Background="#1E1E1E">
                                <Grid Margin="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- App Icon -->
                                    <Border Grid.Column="0" Background="#333333" Margin="0,0,10,0">
                                        <icon:PackIconMaterial Kind="Google" Width="50" Height="50" 
                                                               Foreground="#4285F4" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- 文字資訊 -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Google Meet" FontSize="18" Foreground="White" Margin="0,0,0,5"/>
                                        <Separator Background="#666666" Margin="0,0,0,5"/>
                                        <TextBlock Text="音量縮放: 0%" FontSize="14" Foreground="#BBBBBB"/>
                                        <TextBlock Text="音色調整: 無" FontSize="14" Foreground="#BBBBBB"/>
                                        <TextBlock Text="其他: 靜音" FontSize="14" Foreground="#BBBBBB"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>